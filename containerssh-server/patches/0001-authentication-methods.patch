diff --git a/internal/sshserver/AuthenticationMethods.go b/internal/sshserver/AuthenticationMethods.go
new file mode 100644
index 0000000..cf81e3b
--- /dev/null
+++ b/internal/sshserver/AuthenticationMethods.go
@@ -0,0 +1,28 @@
+package sshserver
+
+// AuthenticationMethods describes the SSH authentication callbacks supported by
+// a connection handler. Authorization is not an authentication method. GSSAPI
+// availability continues to be determined by OnAuthGSSAPI returning a server.
+type AuthenticationMethods struct {
+	Password            bool
+	PublicKey           bool
+	KeyboardInteractive bool
+}
+
+// AuthenticationMethodProvider optionally declares a connection handler's
+// capabilities, without making authentication requests. Overlays must forward
+// this contract or report the capabilities of their composed handler.
+// Handlers without this interface retain the legacy three-callback behavior.
+type AuthenticationMethodProvider interface {
+	AuthenticationMethods() AuthenticationMethods
+}
+
+// AuthenticationMethodsFor returns explicit capabilities when provided, or the
+// legacy set for existing handlers. This keeps custom backend passthrough
+// handlers compatible without assuming that a missing declaration disables them.
+func AuthenticationMethodsFor(handler NetworkConnectionHandler) AuthenticationMethods {
+	if provider, ok := handler.(AuthenticationMethodProvider); ok {
+		return provider.AuthenticationMethods()
+	}
+	return AuthenticationMethods{Password: true, PublicKey: true, KeyboardInteractive: true}
+}
diff --git a/internal/sshserver/serverImpl.go b/internal/sshserver/serverImpl.go
