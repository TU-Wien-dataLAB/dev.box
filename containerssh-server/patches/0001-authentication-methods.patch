@@ -0,0 +1,144 @@
+package authintegration_test
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"encoding/pem"
+	"net"
+	"net/http/httptest"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	publicAuth "go.containerssh.io/containerssh/auth"
+	"go.containerssh.io/containerssh/config"
+	"go.containerssh.io/containerssh/internal/auditlogintegration"
+	"go.containerssh.io/containerssh/internal/auth"
+	"go.containerssh.io/containerssh/internal/authintegration"
+	"go.containerssh.io/containerssh/internal/geoip/dummy"
+	"go.containerssh.io/containerssh/internal/metrics"
+	"go.containerssh.io/containerssh/internal/metricsintegration"
+	"go.containerssh.io/containerssh/internal/sshserver"
+	"go.containerssh.io/containerssh/log"
+	"go.containerssh.io/containerssh/metadata"
+	"golang.org/x/crypto/ssh"
+)
+
+// These tests deliberately leave OpenSSH's authentication preferences and batch
+// mode alone: either would hide the disabled-method advertisement regression.
+func TestOpenSSHPublicKeyOnly(t *testing.T) {
+	_, err := exec.LookPath("ssh")
+	require.NoError(t, err, "OpenSSH is required for the advertisement regression")
+	key, signer := fixtureKey(t)
+	unenrolled, _ := fixtureKey(t)
+	logger := log.NewTestLogger(t)
+	webhook := httptest.NewServer(auth.NewHandler(&advertisementAuthHandler{
+		key: strings.TrimSpace(string(ssh.MarshalAuthorizedKey(signer.PublicKey()))),
+	}, logger))
+	t.Cleanup(webhook.Close)
+	webhookConfig := config.AuthWebhookClientConfig{
+		HTTPClientConfiguration: config.HTTPClientConfiguration{URL: webhook.URL, Timeout: time.Second},
+		AuthTimeout:             time.Second,
+	}
+	handler, _, err := authintegration.New(config.AuthConfig{
+		PublicKeyAuth: config.PublicKeyAuthConfig{Method: config.PubKeyAuthMethodWebhook, Webhook: webhookConfig},
+		Authz:         config.AuthzConfig{Method: config.AuthzMethodWebhook, Webhook: webhookConfig},
+	}, sshserver.NewTestHandler(), logger, metrics.New(dummy.New()), authintegration.BehaviorNoPassthrough)
+	require.NoError(t, err)
+	handler, err = metricsintegration.NewHandler(config.MetricsConfig{Enable: true}, metrics.New(dummy.New()), handler)
+	require.NoError(t, err)
+	handler, err = auditlogintegration.New(config.AuditLogConfig{Enable: true, Format: config.AuditLogFormatNone, Storage: config.AuditLogStorageNone}, handler, dummy.New(), logger)
+	require.NoError(t, err)
+	srv := sshserver.NewTestServer(t, handler, logger, nil)
+	srv.Start()
+
+	// Same key and transport must work before interpreting any denial as a pass.
+	output, err := runOpenSSH(t, srv, key, "configured")
+	require.NoError(t, err, output)
+	require.Contains(t, output, "READY")
+	for _, tc := range []struct{ name, username, key string }{
+		{"unknown-template", "unknown", key},
+		{"unenrolled-key", "configured", unenrolled},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			output, err := runOpenSSH(t, srv, tc.key, tc.username)
+			var exit *exec.ExitError
+			require.ErrorAs(t, err, &exit, output)
+			require.Equal(t, 255, exit.ExitCode(), output)
+			require.Contains(t, output, "Permission denied (publickey)")
+			methods := regexp.MustCompile(`Authentications that can continue: ([^\r\n]+)`).FindAllStringSubmatch(output, -1)
+			require.NotEmpty(t, methods, output)
+			for _, match := range methods {
+				require.Equal(t, "publickey", match[1], output)
+			}
+		})
+	}
+}
+
+func fixtureKey(t *testing.T) (string, ssh.Signer) {
+	t.Helper()
+	_, privateKey, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	signer, err := ssh.NewSignerFromKey(privateKey)
+	require.NoError(t, err)
+	block, err := ssh.MarshalPrivateKey(privateKey, "advertisement fixture")
+	require.NoError(t, err)
+	path := filepath.Join(t.TempDir(), "key")
+	require.NoError(t, os.WriteFile(path, pem.EncodeToMemory(block), 0600))
+	return path, signer
+}
+
+func runOpenSSH(t *testing.T, srv sshserver.TestServer, key, username string) (string, error) {
+	t.Helper()
+	output, err, prompts := observeOpenSSH(t, srv, key, username)
+	require.Empty(t, prompts, "unexpected interactive prompt: %s", prompts)
+	return output, err
+}
+
+func observeOpenSSH(t *testing.T, srv sshserver.TestServer, key, username string) (string, error, string) {
+	t.Helper()
+	dir := t.TempDir()
+	hostKey, err := ssh.ParsePrivateKey([]byte(srv.GetHostKey()))
+	require.NoError(t, err)
+	host, port, err := net.SplitHostPort(srv.GetListen())
+	require.NoError(t, err)
+	knownHosts := filepath.Join(dir, "known_hosts")
+	require.NoError(t, os.WriteFile(knownHosts, []byte("["+host+"]:"+port+" "+string(ssh.MarshalAuthorizedKey(hostKey.PublicKey()))), 0600))
+	askpass := filepath.Join(dir, "askpass")
+	prompts := filepath.Join(dir, "prompts")
+	require.NoError(t, os.WriteFile(askpass, []byte("#!/bin/sh\nprintf '%s\\n' \"$*\" >> \"$PROMPT_LOG\"\nexit 1\n"), 0700))
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "ssh", "-F", "/dev/null", "-vv", "-T", "-i", key,
+		"-o", "IdentitiesOnly=yes", "-o", "IdentityAgent=none", "-o", "StrictHostKeyChecking=yes",
+		"-o", "UserKnownHostsFile="+knownHosts, "-o", "GlobalKnownHostsFile=/dev/null",
+		"-p", port, username+"@"+host, "echo READY")
+	cmd.Env = append(os.Environ(), "LC_ALL=C", "SSH_ASKPASS="+askpass, "SSH_ASKPASS_REQUIRE=force", "DISPLAY=advertisement-test", "PROMPT_LOG="+prompts)
+	output, err := cmd.CombinedOutput()
+	require.NoError(t, ctx.Err(), string(output))
+	promptData, readErr := os.ReadFile(prompts)
+	if !os.IsNotExist(readErr) {
+		require.NoError(t, readErr)
+	}
+	return string(output), err, string(promptData)
+}
+
+type advertisementAuthHandler struct{ key string }
+
+func (h *advertisementAuthHandler) OnPassword(meta metadata.ConnectionAuthPendingMetadata, password []byte) (bool, metadata.ConnectionAuthenticatedMetadata, error) {
+	return string(password) == "fixture-password", meta.Authenticated("owner"), nil
+}
+
+func (h *advertisementAuthHandler) OnPubKey(meta metadata.ConnectionAuthPendingMetadata, key publicAuth.PublicKey) (bool, metadata.ConnectionAuthenticatedMetadata, error) {
+	return key.PublicKey == h.key, meta.Authenticated("owner"), nil
+}
+
+func (h *advertisementAuthHandler) OnAuthorization(meta metadata.ConnectionAuthenticatedMetadata) (bool, metadata.ConnectionAuthenticatedMetadata, error) {
+	return meta.Username == "configured", meta, nil
+}
