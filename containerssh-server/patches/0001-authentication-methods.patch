index 0000000..1a17e94
--- /dev/null
+++ b/internal/authintegration/advertisement_matrix_test.go
@@ -0,0 +1,173 @@
+package authintegration_test
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os/exec"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.containerssh.io/containerssh/config"
+	"go.containerssh.io/containerssh/internal/auth"
+	"go.containerssh.io/containerssh/internal/authintegration"
+	"go.containerssh.io/containerssh/internal/geoip/dummy"
+	"go.containerssh.io/containerssh/internal/metrics"
+	"go.containerssh.io/containerssh/internal/sshserver"
+	"go.containerssh.io/containerssh/internal/structutils"
+	"go.containerssh.io/containerssh/log"
+	"go.containerssh.io/containerssh/metadata"
+	"golang.org/x/crypto/ssh"
+)
+
+func TestOpenSSHAuthenticationMatrix(t *testing.T) {
+	for _, tc := range []struct {
+		name                             string
+		password, publicKey, interactive bool
+		methods                          []string
+	}{
+		{"password", true, false, false, []string{"password"}},
+		{"public-key", false, true, false, []string{"publickey"}},
+		{"keyboard-interactive", false, false, true, []string{"keyboard-interactive"}},
+		{"password-and-key", true, true, false, []string{"password", "publickey"}},
+		{"password-and-interactive", true, false, true, []string{"password", "keyboard-interactive"}},
+		{"key-and-interactive", false, true, true, []string{"publickey", "keyboard-interactive"}},
+		{"all", true, true, true, []string{"password", "publickey", "keyboard-interactive"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			key, signer := fixtureKey(t)
+			logger := log.NewTestLogger(t)
+			webhookHandler := auth.NewHandler(&advertisementAuthHandler{
+				key: strings.TrimSpace(string(ssh.MarshalAuthorizedKey(signer.PublicKey()))),
+			}, logger)
+			webhook := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path == "/token" {
+					require.NoError(t, r.ParseForm())
+					require.Equal(t, "fixture-code", r.Form.Get("code"))
+					w.Header().Set("Content-Type", "application/json")
+					_, _ = w.Write([]byte(`{"access_token":"fixture-token","token_type":"Bearer"}`))
+					return
+				}
+				webhookHandler.ServeHTTP(w, r)
+			}))
+			t.Cleanup(webhook.Close)
+			webhookConfig := config.AuthWebhookClientConfig{
+				HTTPClientConfiguration: config.HTTPClientConfiguration{URL: webhook.URL, Timeout: time.Second},
+				AuthTimeout:             time.Second,
+			}
+			cfg := config.AuthConfig{Authz: config.AuthzConfig{Method: config.AuthzMethodWebhook, Webhook: webhookConfig}}
+			var enabled []ssh.AuthMethod
+			if tc.password {
+				cfg.PasswordAuth = config.PasswordAuthConfig{Method: config.PasswordAuthMethodWebhook, Webhook: webhookConfig}
+				enabled = append(enabled, ssh.Password("fixture-password"))
+			}
+			if tc.publicKey {
+				cfg.PublicKeyAuth = config.PublicKeyAuthConfig{Method: config.PubKeyAuthMethodWebhook, Webhook: webhookConfig}
+				enabled = append(enabled, ssh.PublicKeys(signer))
+			}
+			if tc.interactive {
+				cfg.KeyboardInteractiveAuth.Method = config.KeyboardInteractiveAuthMethodOAuth2
+				oauth := &cfg.KeyboardInteractiveAuth.OAuth2
+				structutils.Defaults(oauth)
+				oauth.Provider = config.AuthOAuth2GenericProvider
+				oauth.ClientID, oauth.ClientSecret = "fixture-client", "fixture-secret"
+				oauth.Generic = config.AuthGenericConfig{
+					AuthorizeEndpointURL: webhook.URL + "/authorize", RedirectURI: webhook.URL + "/callback",
+					TokenEndpoint: config.HTTPClientConfiguration{URL: webhook.URL + "/token", Timeout: time.Second},
+				}
+				enabled = append(enabled, ssh.KeyboardInteractive(func(user, instruction string, questions []string, echos []bool) ([]string, error) {
+					require.Len(t, questions, 1)
+					return []string{"fixture-state|fixture-code"}, nil
+				}))
+			}
+			handler, _, err := authintegration.New(cfg, sshserver.NewTestHandler(), logger, metrics.New(dummy.New()), authintegration.BehaviorNoPassthrough)
+			require.NoError(t, err)
+			srv := sshserver.NewTestServer(t, handler, logger, nil)
+			srv.Start()
+			// Exercise each enabled method separately on the same SSH transport.
+			for _, method := range enabled {
+				connectWithMethod(t, srv, method)
+			}
+			output, err, _ := observeOpenSSH(t, srv, key, "unknown")
+			var exit *exec.ExitError
+			require.ErrorAs(t, err, &exit, output)
+			require.Equal(t, 255, exit.ExitCode(), output)
+			advertised := regexp.MustCompile(`Authentications that can continue: ([^\r\n]+)`).FindAllStringSubmatch(output, -1)
+			require.NotEmpty(t, advertised, output)
+			for _, match := range advertised {
+				require.ElementsMatch(t, tc.methods, strings.Split(match[1], ","), output)
+			}
+		})
+	}
+}
+
+func connectWithMethod(t *testing.T, srv sshserver.TestServer, method ssh.AuthMethod) {
+	t.Helper()
+	hostKey, err := ssh.ParsePrivateKey([]byte(srv.GetHostKey()))
+	require.NoError(t, err)
+	client, err := ssh.Dial("tcp", srv.GetListen(), &ssh.ClientConfig{
+		User: "configured", Auth: []ssh.AuthMethod{method},
+		HostKeyCallback: ssh.FixedHostKey(hostKey.PublicKey()), Timeout: 5 * time.Second,
+	})
+	require.NoError(t, err)
+	require.NoError(t, client.Close())
+}
+
+func TestAuthenticationPassthrough(t *testing.T) {
+	for _, behavior := range []authintegration.Behavior{
+		authintegration.BehaviorPassthroughOnSuccess,
+		authintegration.BehaviorPassthroughOnFailure,
+		authintegration.BehaviorPassthroughOnUnavailable,
+	} {
+		t.Run(fmt.Sprint(behavior), func(t *testing.T) {
+			logger := log.NewTestLogger(t)
+			webhook := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if behavior == authintegration.BehaviorPassthroughOnUnavailable {
+					w.WriteHeader(http.StatusServiceUnavailable)
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				if behavior == authintegration.BehaviorPassthroughOnSuccess {
+					_, _ = w.Write([]byte(`{"success":true,"authenticatedUsername":"owner"}`))
+				} else {
+					_, _ = w.Write([]byte(`{"success":false}`))
+				}
+			}))
+			t.Cleanup(webhook.Close)
+			handler, _, err := authintegration.New(config.AuthConfig{
+				PasswordAuth: config.PasswordAuthConfig{Method: config.PasswordAuthMethodWebhook,
+					Webhook: config.AuthWebhookClientConfig{
+						HTTPClientConfiguration: config.HTTPClientConfiguration{URL: webhook.URL, Timeout: time.Second},
+						AuthTimeout:             100 * time.Millisecond,
+					}},
+			}, &passthroughBackend{Handler: sshserver.NewTestHandler()}, logger, metrics.New(dummy.New()), behavior)
+			require.NoError(t, err)
+			srv := sshserver.NewTestServer(t, handler, logger, nil)
+			srv.Start()
+			connectWithMethod(t, srv, ssh.Password("backend-password"))
+		})
+	}
+}
+
+// The backend implements the existing handler contract without a capability
+// declaration: legacy passthrough backends must keep working after the change.
+type passthroughBackend struct{ sshserver.Handler }
+
+func (b *passthroughBackend) OnNetworkConnection(meta metadata.ConnectionMetadata) (sshserver.NetworkConnectionHandler, metadata.ConnectionMetadata, error) {
+	backend, meta, err := b.Handler.OnNetworkConnection(meta)
+	return &passthroughNetwork{NetworkConnectionHandler: backend}, meta, err
+}
+
+type passthroughNetwork struct {
+	sshserver.NetworkConnectionHandler
+}
+
+func (b *passthroughNetwork) OnAuthPassword(meta metadata.ConnectionAuthPendingMetadata, password []byte) (sshserver.AuthResponse, metadata.ConnectionAuthenticatedMetadata, error) {
+	if string(password) == "backend-password" {
+		return sshserver.AuthResponseSuccess, meta.Authenticated("owner"), nil
+	}
+	return sshserver.AuthResponseFailure, meta.AuthFailed(), nil
+}
